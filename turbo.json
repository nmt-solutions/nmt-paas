{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "APP_ENV",
        "APP_PORT",
        "DB_ENV",
        "WORKOS_CLIENT_ID",
        "WORKOS_API_KEY",
        "WORKOS_COOKIE_PASSWORD",
        "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
        "DEV_DATABASE_URL",
        "PROD_DATABASE_URL",
        "GITHUB_APP_ID",
        "GITHUB_APP_SLUG",
        "GITHUB_APP_PRIVATE_KEY",
        "ENV_ENCRYPTION_KEY",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db-gen": {
      "cache": false
    },
    "db-mig": {
      "cache": false
    },
    "db-studio": {
      "cache": false
    }
  }
}

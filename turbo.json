{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "APP_ENV",
        "WORKOS_CLIENT_ID",
        "WORKOS_API_KEY",
        "WORKOS_COOKIE_PASSWORD",
        "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
        "DB_ENV",
        "DEV_DATABASE_URL",
        "PROD_DATABASE_URL",
        "GITHUB_APP_ID",
        "GITHUB_APP_SLUG",
        "GITHUB_APP_CLIENT_ID",
        "GITHUB_APP_CLIENT_SECRET",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_PAT",
        "GITHUB_USER_NAME",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "ENV_ENCRYPTION_KEY",
        "BASE_DOMAIN",
        "API_APP_PORT",
        "API_KEY",
        "API_BASE_URL",
        "VERCEL_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["TEST_DATABASE_URL"]
    },
    "test:auth": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["AUTH_TEST_DATABASE_URL"]
    },
    "test:import": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["IMPORT_TEST_DATABASE_URL"]
    },
    "test:eligibility": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["AUTH_TEST_DATABASE_URL"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false,
      "env": ["DATABASE_TEST_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db-gen": {
      "cache": false,
      "env": [
        "APP_ENV",
        "DB_ENV",
        "DEV_DATABASE_URL",
        "PROD_DATABASE_URL",
        "BASE_DOMAIN"
      ]
    },
    "db-mig": {
      "cache": false,
      "env": [
        "APP_ENV",
        "DB_ENV",
        "DEV_DATABASE_URL",
        "PROD_DATABASE_URL",
        "BASE_DOMAIN"
      ]
    },
    "db-studio": {
      "cache": false,
      "env": [
        "APP_ENV",
        "DB_ENV",
        "DEV_DATABASE_URL",
        "PROD_DATABASE_URL",
        "BASE_DOMAIN"
      ]
    }
  }
}
